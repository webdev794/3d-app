APP_NAME=3DEEZI
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# The address people open, e.g. https://test.3deezi.com
APP_URL=https://YOUR-TEST-SERVER

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# SQLite works out of the box (database/database.sqlite).
# For MySQL: DB_CONNECTION=mysql and fill in the DB_* values.
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=threedeezi
# DB_USERNAME=
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Browser origins allowed to call the API from another domain. The website
# and the mobile apps don't need this; leave it as the site's own address.
CORS_ALLOWED_ORIGINS=https://YOUR-TEST-SERVER

# Real AI (concepts, patterns, Showcase). Without a key the website uses its
# built-in procedural designs. The key stays on the server.
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-6-luna
OPENAI_IMAGE_MODEL=gpt-image-2
