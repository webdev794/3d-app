APP_NAME=3DEEZI
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# The address people open, e.g. https://test.3deezi.com
APP_URL=https://YOUR-TEST-SERVER

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# SQLite works out of the box (database/database.sqlite).
# For MySQL: DB_CONNECTION=mysql and fill in the DB_* values.
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=threedeezi
# DB_USERNAME=
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Browser origins allowed to call the API from another domain. The website
# and the mobile apps don't need this; leave it as the site's own address.
CORS_ALLOWED_ORIGINS=https://YOUR-TEST-SERVER

# Real AI (concepts, patterns, Showcase). Without a key the website uses its
# built-in procedural designs. The key stays on the server.
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-6-luna
OPENAI_IMAGE_MODEL=gpt-image-2

# Online payments for invoices. airwallex or stripe; empty = Airwallex when its keys are set, else Stripe.
PAYMENTS_PROVIDER=
# Airwallex: Settings > Developer > API keys (the Client ID and an API key). Put real values only on the server.
AIRWALLEX_CLIENT_ID=
AIRWALLEX_API_KEY=
# Airwallex: Settings > Developer > Webhooks. Notification URL: https://YOUR-SERVER/api/v1/payments/airwallex/webhook
# Events: payment_intent.succeeded, payment_intent.payment_failed, payment_intent.pending, payment_intent.cancelled,
# payment_attempt.authorization_failed, payment_attempt.failed_to_process, refund.accepted, refund.settled, refund.failed
AIRWALLEX_WEBHOOK_SECRET=
# demo first (Airwallex sandbox, test cards); prod once the demo test passes, with the LIVE keys and live webhook.
AIRWALLEX_ENV=demo
# Usually empty: only for an API key that covers several Airwallex accounts.
AIRWALLEX_ACCOUNT_ID=
# Stripe (optional alternative): Stripe > Developers > API keys, and the webhook's signing secret.
# Webhook URL: https://YOUR-SERVER/api/v1/payments/stripe/webhook
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
# Leave empty on the live site. true = simulated TEST payments (only without provider keys; shows a TEST banner).
PAYMENTS_TEST_MODE=
