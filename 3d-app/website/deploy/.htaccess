# Used when the web server serves this folder instead of public/ (shared
# hosting, sub-folders). Static files come from public/; every other request,
# including any attempt to read .env or the source code, goes to Laravel.
<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Pass the login token through to Laravel.
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Built frontend, images, fonts, the 3D viewer and the 3D showroom.
    RewriteRule ^showroom$ %{REQUEST_URI}/ [R=301,L]
    RewriteRule ^showroom/$ public/showroom/index.html [L]
    RewriteRule ^(build|media|showroom)/(.*)$ public/$1/$2 [L]
    RewriteRule ^(favicon\.ico|robots\.txt)$ public/$1 [L]

    # Everything else is handled by Laravel.
    RewriteCond %{REQUEST_URI} !/public/
    RewriteRule ^ index.php [L]
</IfModule>
